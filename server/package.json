{
  "name": "brevly-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/infra/http/server.ts",
    "build": "tsup-node",
    "start": "node dist/server.js",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@fastify/cors": "^10.0.2",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.39.1",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "postgres": "^3.4.5",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.4"
  }
}
